# HAMATRIX — client environment
# Copy this file to client/.env and adjust the values.
# This file configures the frontend only; the API and database live in server/.env.

# ─── API URL ────────────────────────────────────────────────────────────────
# Leave empty when the same server hosts both the SPA and the API (default):
#   - Development: Vite proxies /api, /uploads and /socket.io to
#     VITE_API_PROXY_TARGET.
#   - Production: Express serves client/dist on the same origin.
#
# Set a full URL only when the API runs on another host/port, for example:
#   VITE_API_URL=https://api.example.com
#   VITE_API_URL=http://192.168.1.10:4010
# The /api/v1 suffix is optional — it is added automatically.
VITE_API_URL=

# ─── Dev proxy target ───────────────────────────────────────────────────────
# Where the API runs locally (must match PORT in server/.env).
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# ─── Dev server port ────────────────────────────────────────────────────────
VITE_DEV_PORT=5173

# ─── Live updates ───────────────────────────────────────────────────────────
# Socket.IO needs a long-lived server. Set to false on serverless hosts such as
# Vercel: the UI then refetches active data every VITE_POLL_INTERVAL_MS.
VITE_ENABLE_SOCKET=true
VITE_POLL_INTERVAL_MS=15000
